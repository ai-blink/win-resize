<UserControl x:Class="WindowResizer.App.Overlay.OverlayButtonFace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 모양, 색, 게이지는 코드(Draw)가 스타일에서 만든다. -->
    <Grid>
        <Path x:Name="Face" />
        <Grid x:Name="GaugeLayer">
            <Rectangle x:Name="FillGauge" HorizontalAlignment="Left" Width="0" />
            <Rectangle x:Name="BarGauge" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="0" />
        </Grid>
        <Path x:Name="OutlineGauge" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <TextBlock x:Name="Label" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
