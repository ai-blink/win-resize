<Application x:Class="WindowResizer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:WindowResizer.App.Mvvm"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 표시 언어. 기본은 한국어(D-017). App.xaml.cs 가 설정에 따라 바꿔 끼운다. -->
                <ResourceDictionary Source="Resources/Strings.ko.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 색 토큰(계획 4.7, magnifier 기준). 시작 시 Theme.Apply 가 밝게/어둡게/고대비 값으로 덮는다.
                 XAML 은 전부 DynamicResource 로 참조해야 즉시 바뀐다. -->
            <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI, Malgun Gothic</FontFamily>
            <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F5F6F8" />
            <SolidColorBrush x:Key="AppPanelBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppCanvasBrush" Color="#F7F9FD" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#DFE3E9" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#17232F" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#65717D" />
            <SolidColorBrush x:Key="AppHoverBrush" Color="#EDF0F4" />
            <SolidColorBrush x:Key="AppPressedBrush" Color="#DFE5ED" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#286BE8" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#1F5FCE" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#EAF1FF" />
            <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#C42B1C" />

            <mvvm:EqualsConverter x:Key="EqualsConverter" />
            <mvvm:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
            <mvvm:YesNoConverter x:Key="YesNo" />
            <mvvm:TargetTextConverter x:Key="TargetText" />
            <mvvm:ResourceTextConverter x:Key="ResourceText" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <sys:Boolean x:Key="TrueValue">True</sys:Boolean>
            <sys:Boolean x:Key="FalseValue">False</sys:Boolean>

            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="TextElement.FontSize" Value="14" />
            </Style>

            <!-- 버튼: 클릭 대상 최소 높이 44 (계획 4.7, test_profile_actions_have_text_clearance 와 같은 방향) -->
            <Style x:Key="AppButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppHoverBrush}" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppPressedBrush}" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AppButtonStyle}" />

            <Style x:Key="AccentButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppAccentHoverBrush}" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 켜고 끄는 칩(단축키 수정키). 꺼짐은 테두리만 있는 흐린 칩, 켜짐은 강조색으로 꽉 채우고 체크 표시와 굵은 글자를 더한다 -
                 색 하나에만 기대지 않아야 한 눈에 켜진 것이 보인다. -->
            <Style x:Key="ChipToggleStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="MinWidth" Value="60" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="Chrome" CornerRadius="8" BorderThickness="1.5" SnapsToDevicePixels="True"
                                    Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                    <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                               Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppHoverBrush}" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" /></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <!-- 사이드바(계획 4.2.1, key-demo-osk NavItemStyle 모양 + magnifier 색과 44px) -->
            <Style x:Key="NavGroupHeaderStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="20,16,12,4" />
            </Style>

            <Style x:Key="NavItemStyle" TargetType="{x:Type RadioButton}">
                <Setter Property="GroupName" Value="MainNavigation" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Grid Background="Transparent">
                                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,8" CornerRadius="0,2,2,0"
                                        Background="{DynamicResource AppAccentBrush}" Visibility="Collapsed" />
                                <Border x:Name="Chrome" Margin="8,1" CornerRadius="8" Background="Transparent" Padding="12,0"
                                        BorderThickness="1" BorderBrush="Transparent">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppHoverBrush}" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" /></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 사이드바의 페이지가 아닌 동작(계획 4.2.1 NavActionStyle). 항목과 같은 모양이지만 선택 상태가 없다. -->
            <Style x:Key="NavActionStyle" TargetType="{x:Type Button}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Chrome" Margin="8,1" CornerRadius="8" Background="Transparent" Padding="12,0"
                                    BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppHoverBrush}" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppPressedBrush}" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavIconStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CountPillStyle" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource AppCanvasBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 값이 길어도 드래그로 골라 복사할 수 있는 읽기 전용 글상자(정보 페이지). 테두리 없이 글처럼 보인다. -->
            <Style x:Key="InfoValueStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 편집 창(계획 4.4, magnifier SettingsWindow 구조). 사이드바 항목은 메인과 같은 모양, 그룹만 다르다. -->
            <Style x:Key="EditorNavItemStyle" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource NavItemStyle}">
                <Setter Property="GroupName" Value="EditorNavigation" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            </Style>
            <Style x:Key="PageSubtitleStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,7,0,22" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            </Style>
            <Style x:Key="FieldHintStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,18" />
                <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            </Style>
            <!-- 카드형 선택지(계획 4.7, magnifier). 제목 + 설명 두 줄, 선택되면 강조 테두리와 연한 배경. -->
            <Style x:Key="ChoiceCardStyle" TargetType="{x:Type RadioButton}">
                <Setter Property="MinHeight" Value="72" />
                <Setter Property="MinWidth" Value="200" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Border x:Name="Card" CornerRadius="10" BorderThickness="1.5" Padding="16,12"
                                    Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource AppHoverBrush}" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" /></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 콤보박스. 기본 템플릿은 시스템 회색이라 다크 모드에서 혼자 밝게 뜬다. 토큰 색으로 직접 그리고 44px 높이를 맞춘다. -->
            <Style x:Key="ComboToggleStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ClickMode" Value="Press" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="Chrome" CornerRadius="8" BorderThickness="1" SnapsToDevicePixels="True"
                                    Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}">
                                <Path Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource AppMutedTextBrush}" StrokeThickness="1.8"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppHoverBrush}" /></Trigger>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ComboBoxItem}">
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                            <Border x:Name="Row" CornerRadius="6" Margin="4,1" Padding="{TemplateBinding Padding}" Background="Transparent" SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AppHoverBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid x:Name="Root">
                                <ToggleButton x:Name="Toggle" Style="{StaticResource ComboToggleStyle}"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                <ContentPresenter IsHitTestVisible="False" Margin="12,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                       Focusable="False" PopupAnimation="Fade">
                                    <Border MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,8"
                                            CornerRadius="8" BorderThickness="1" Padding="0,4" SnapsToDevicePixels="True"
                                            Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}">
                                        <ScrollViewer>
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            </Style>

            <Style TargetType="{x:Type TextBox}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            </Style>

            <!-- 목록. 기본 ListViewItem 템플릿은 선택 행을 시스템 하늘색으로 칠해 다크 모드에서 글자가
                 안 보인다. 템플릿을 직접 두고 토큰 색을 쓴다. -->
            <Style TargetType="{x:Type ListView}">
                <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style TargetType="{x:Type ListViewItem}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                            <Border x:Name="Row" Background="Transparent" BorderThickness="0" Padding="0,2">
                                <GridViewRowPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AppHoverBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type GridViewColumnHeader}">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource AppCanvasBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- 메뉴(막대 팝업, 오버레이 버튼 우클릭)는 시스템 모양 대신 앱 색 토큰으로 그린다. 시스템 템플릿의 회색 아이콘 칸은
                 없앴고, 체크 칸은 메뉴 막대 안의 하위 항목에만 둔다(우클릭 메뉴에는 체크 항목이 없다). -->
            <Style TargetType="{x:Type Menu}">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="Padding" Value="4,2" />
            </Style>
            <Style TargetType="{x:Type ContextMenu}">
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContextMenu}">
                            <Border Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1" Padding="0,4">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Separator}">
                            <Border Height="1" Margin="0,4" Background="{DynamicResource AppBorderBrush}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="CheckHost" Width="0" Height="12" VerticalAlignment="Center">
                                            <Path x:Name="Check" Visibility="Collapsed" Data="M1,6 L4.5,9.5 L11,2" Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.6" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        </Border>
                                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Margin="28,0,0,0" VerticalAlignment="Center"
                                                   Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource AppMutedTextBrush}" />
                                        <Path x:Name="Arrow" Grid.Column="3" Visibility="Collapsed" Margin="12,0,0,0" Data="M0,0 L4,4 L0,8"
                                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Popup x:Name="Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False"
                                       AllowsTransparency="False" PopupAnimation="None">
                                    <Border Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1" Padding="0,4">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Role" Value="TopLevelHeader">
                                    <Setter TargetName="Popup" Property="Placement" Value="Bottom" />
                                    <Setter Property="Padding" Value="10,4" />
                                </Trigger>
                                <Trigger Property="Role" Value="TopLevelItem">
                                    <Setter Property="Padding" Value="10,4" />
                                </Trigger>
                                <Trigger Property="Role" Value="SubmenuHeader">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Role, RelativeSource={RelativeSource Self}}" Value="SubmenuItem" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Value="{x:Null}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="CheckHost" Property="Width" Value="22" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Role, RelativeSource={RelativeSource Self}}" Value="SubmenuHeader" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Value="{x:Null}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="CheckHost" Property="Width" Value="22" />
                                </MultiDataTrigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
