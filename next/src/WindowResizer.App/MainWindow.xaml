<Window x:Class="WindowResizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WindowResizer.App.ViewModels"
        xmlns:local="clr-namespace:WindowResizer.App"
        Title="{DynamicResource App.Title}"
        Icon="pack://application:,,,/WindowResizer.App;component/Assets/app.ico"
        Width="1320" Height="780" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppSurfaceBrush}"
        Foreground="{DynamicResource AppTextBrush}">

    <!-- 버튼, 메뉴, 키가 같은 명령을 쓴다(계획 4.1). Ctrl+F 는 Find 명령으로 검색 상자에 초점을 준다. -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding ExitCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding NewProfileFromWindowCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.LogAndAbout}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFind" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 보조 경로(D-018). 주 경로는 왼쪽 사이드바다. -->
        <Menu Grid.Row="0">
            <MenuItem Header="{DynamicResource Menu.File}">
                <MenuItem Header="{DynamicResource Menu.Refresh}" InputGestureText="F5" Command="{Binding RefreshCommand}" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Exit}" InputGestureText="Ctrl+Q" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Profile}">
                <MenuItem Header="{DynamicResource Menu.Apply}" InputGestureText="Enter" Command="{Binding ApplyProfileCommand}" />
                <MenuItem Header="{DynamicResource Menu.ApplyAll}" Command="{Binding ApplyAllProfilesCommand}" />
                <MenuItem Header="{DynamicResource Menu.NewFromWindow}" InputGestureText="Ctrl+S" Command="{Binding NewProfileFromWindowCommand}" />
                <MenuItem Header="{DynamicResource Menu.Edit}" Command="{Binding EditProfileCommand}" />
                <MenuItem Header="{DynamicResource Menu.OverwritePosition}" Command="{Binding OverwritePositionCommand}" />
                <MenuItem Header="{DynamicResource Menu.Undo}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Delete}" InputGestureText="Del" Command="{Binding DeleteProfileCommand}" />
            </MenuItem>
            <!-- PyQt5 의 프로필 메뉴 오버레이 항목들. 같은 Overlay 객체를 보므로 페이지와 트레이와 늘 같은 값이다. -->
            <MenuItem Header="{DynamicResource Menu.Overlay}">
                <!-- 둘 중 하나(PyQt5 는 배타 그룹). 체크는 표시만, 선택은 명령 - 체크된 항목을 다시 눌러도 뒤집히지 않는다. -->
                <MenuItem Header="{DynamicResource Overlay.Click}" IsChecked="{Binding Overlay.IsClick, Mode=OneWay}"
                          Command="{Binding Overlay.SetDwellCommand}" CommandParameter="{StaticResource FalseValue}" />
                <MenuItem Header="{DynamicResource Overlay.Dwell}" IsChecked="{Binding Overlay.IsDwell, Mode=OneWay}"
                          Command="{Binding Overlay.SetDwellCommand}" CommandParameter="{StaticResource TrueValue}" />
                <Separator />
                <MenuItem Header="{DynamicResource Overlay.Hidden}" IsCheckable="True" IsChecked="{Binding Overlay.Hidden}" />
                <MenuItem Header="{DynamicResource Overlay.Switch}" IsCheckable="True" IsChecked="{Binding Overlay.ToggleVisible}" />
                <MenuItem Header="{DynamicResource Overlay.Locked}" IsCheckable="True" IsChecked="{Binding Overlay.Locked}" />
                <Separator />
                <MenuItem Header="{DynamicResource Overlay.CloseAll}" Command="{Binding CloseAllOverlaysCommand}" />
                <MenuItem Header="{DynamicResource Menu.OverlayPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Overlay}" />
            </MenuItem>
            <!-- 메뉴 지도: 도구 > 디버그 창 열기(Ctrl+D)와 도움말 > 정보는 [로그와 정보] 페이지가 대신한다. -->
            <MenuItem Header="{DynamicResource Menu.Tools}">
                <MenuItem Header="{DynamicResource Menu.Log}" InputGestureText="Ctrl+D" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.LogAndAbout}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Help}">
                <MenuItem Header="{DynamicResource Menu.About}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.LogAndAbout}" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽 사이드바(계획 4.2.1, key-demo-osk 패턴) -->
            <Border Grid.Column="0" Background="{DynamicResource AppCanvasBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
              <DockPanel>
                <!-- 왼쪽 아래 프로그램 종료. 메뉴 "종료"(Ctrl+Q), 트레이 "프로그램 종료"와 같은 명령이다(D-020).
                     창 닫기(X)는 트레이로 숨기므로, 진짜로 끝내는 길이 화면에 보여야 한다. -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavActionStyle}" Margin="0,0,0,12"
                        Command="{Binding ExitCommand}"
                        ToolTip="{DynamicResource Nav.Exit.Hint}"
                        AutomationProperties.Name="{DynamicResource Nav.Exit}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavIconStyle}" Text="&#xE7E8;" />
                        <TextBlock Text="{DynamicResource Nav.Exit}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Margin="0,14,0,16">
                    <TextBlock Text="{DynamicResource App.Title}" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource AppTextBrush}" Margin="20,4,0,0" />
                    <TextBlock Text="{x:Static local:AppInfo.DisplayVersion}" FontSize="11.5"
                               Foreground="{DynamicResource AppMutedTextBrush}" Margin="20,2,0,6" />

                    <TextBlock Text="{DynamicResource Nav.Group.Work}" Style="{StaticResource NavGroupHeaderStyle}" />
                    <RadioButton Style="{StaticResource NavItemStyle}"
                                 AutomationProperties.Name="{DynamicResource Nav.WindowsAndProfiles}"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.WindowsAndProfiles}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static vm:AppPage.WindowsAndProfiles}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NavIconStyle}" Text="&#xE8A9;" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Nav.WindowsAndProfiles}" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Style="{StaticResource CountPillStyle}">
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource AppMutedTextBrush}">
                                    <Run Text="{Binding WindowCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding ProfileCount, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </Grid>
                    </RadioButton>

                    <TextBlock Text="{DynamicResource Nav.Group.Tools}" Style="{StaticResource NavGroupHeaderStyle}" />
                    <RadioButton Style="{StaticResource NavItemStyle}"
                                 AutomationProperties.Name="{DynamicResource Nav.Overlay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Overlay}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static vm:AppPage.Overlay}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIconStyle}" Text="&#xE8A7;" />
                            <TextBlock Text="{DynamicResource Nav.Overlay}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItemStyle}"
                                 AutomationProperties.Name="{DynamicResource Nav.Hotkeys}"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Hotkeys}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static vm:AppPage.Hotkeys}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIconStyle}" Text="&#xE765;" />
                            <TextBlock Text="{DynamicResource Nav.Hotkeys}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="{DynamicResource Nav.Group.App}" Style="{StaticResource NavGroupHeaderStyle}" />
                    <RadioButton Style="{StaticResource NavItemStyle}"
                                 AutomationProperties.Name="{DynamicResource Nav.Settings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Settings}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static vm:AppPage.Settings}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIconStyle}" Text="&#xE713;" />
                            <TextBlock Text="{DynamicResource Nav.Settings}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItemStyle}"
                                 AutomationProperties.Name="{DynamicResource Nav.LogAndAbout}"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.LogAndAbout}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static vm:AppPage.LogAndAbout}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIconStyle}" Text="&#xE946;" />
                            <TextBlock Text="{DynamicResource Nav.LogAndAbout}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- 본문 -->
            <Grid Grid.Column="1" Margin="24,18,24,12">

                <!-- 창과 프로필: 가로 2단 + GridSplitter (계획 4.2, 4.0 확정) -->
                <Grid Visibility="{Binding Page, Converter={StaticResource EqualsToVisibility}, ConverterParameter={x:Static vm:AppPage.WindowsAndProfiles}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <!-- 창 목록 -->
                    <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitleStyle}" Margin="0,0,12,0">
                                <Run Text="{DynamicResource Windows.Header}" />
                                <Run Text="{Binding WindowCount, Mode=OneWay}" Foreground="{DynamicResource AppMutedTextBrush}" FontWeight="Normal" />
                            </TextBlock>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE72C;"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="{DynamicResource Windows.Refresh}"
                                    AutomationProperties.Name="{DynamicResource Windows.Refresh}" Margin="8,0,0,0" />
                            <Grid>
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Windows.Search}"
                                         AutomationProperties.Name="{DynamicResource Windows.Search}" />
                                <!-- 입력 전 안내. 빈 상자만 있으면 무슨 칸인지 모른다. -->
                                <TextBlock Text="{DynamicResource Windows.Search}" Margin="14,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppMutedTextBrush}" IsHitTestVisible="False"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                        <!-- 창 쪽 맥락 액션 바(D-021 결정 1) -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="{DynamicResource Action.NewFromWindow}"
                                    Command="{Binding NewProfileFromWindowCommand}"
                                    ToolTip="{DynamicResource Action.NewFromWindowHint}"
                                    AutomationProperties.Name="{DynamicResource Action.NewFromWindow}" />
                        </StackPanel>
                        <ListView ItemsSource="{Binding WindowsView}" SelectedItem="{Binding SelectedWindow}"
                                  SelectionMode="Single" AutomationProperties.Name="{DynamicResource Windows.Header}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{DynamicResource Col.WindowTitle}" Width="260" DisplayMemberBinding="{Binding DisplayTitle}" />
                                    <GridViewColumn Header="{DynamicResource Col.Pid}" Width="64" DisplayMemberBinding="{Binding ProcessId}" />
                                    <GridViewColumn Header="{DynamicResource Col.Process}" Width="120" DisplayMemberBinding="{Binding ProcessName}" />
                                    <GridViewColumn Header="{DynamicResource Col.X}" Width="60" DisplayMemberBinding="{Binding Rect.X}" />
                                    <GridViewColumn Header="{DynamicResource Col.Y}" Width="60" DisplayMemberBinding="{Binding Rect.Y}" />
                                    <GridViewColumn Header="{DynamicResource Col.Width}" Width="60" DisplayMemberBinding="{Binding Rect.Width}" />
                                    <GridViewColumn Header="{DynamicResource Col.Height}" Width="60" DisplayMemberBinding="{Binding Rect.Height}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" Background="Transparent"
                                  ResizeBehavior="PreviousAndNext" />

                    <!-- 프로필 목록 + 맥락 액션 바 -->
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" MinHeight="44">
                            <TextBlock Style="{StaticResource SectionTitleStyle}">
                                <Run Text="{DynamicResource Profiles.Header}" />
                                <Run Text="{Binding ProfileCount, Mode=OneWay}" Foreground="{DynamicResource AppMutedTextBrush}" FontWeight="Normal" />
                            </TextBlock>
                        </DockPanel>
                        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{DynamicResource Action.Delete}" MinWidth="88" Margin="0,0,10,0"
                                        Command="{Binding DeleteProfileCommand}"
                                        AutomationProperties.Name="{DynamicResource Action.Delete}" />
                                <Button Content="{DynamicResource Action.OverwritePosition}" Margin="0,0,10,0"
                                        Command="{Binding OverwritePositionCommand}"
                                        ToolTip="{DynamicResource Action.OverwritePositionHint}"
                                        AutomationProperties.Name="{DynamicResource Action.OverwritePosition}" />
                                <Button Content="{DynamicResource Action.Edit}" MinWidth="88" Margin="0,0,10,0"
                                        Command="{Binding EditProfileCommand}"
                                        ToolTip="{DynamicResource Action.EditHint}"
                                        AutomationProperties.Name="{DynamicResource Action.Edit}" />
                                <Button Style="{StaticResource AccentButtonStyle}" Content="{DynamicResource Action.Apply}" MinWidth="112"
                                        Command="{Binding ApplyProfileCommand}"
                                        ToolTip="{DynamicResource Action.ApplyHint}"
                                        AutomationProperties.Name="{DynamicResource Action.Apply}" />
                            </StackPanel>
                        </Border>
                        <ListView x:Name="ProfileList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                  SelectionMode="Single" AutomationProperties.Name="{DynamicResource Profiles.Header}">
                            <!-- 읽지 못한 프로필은 흐리게, 이유는 툴팁으로(D-022) -->
                            <ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUnreadable}" Value="True">
                                            <Setter Property="Opacity" Value="0.5" />
                                            <Setter Property="ToolTip" Value="{Binding Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ApplyProfileCommand}" />
                                <KeyBinding Key="Delete" Command="{Binding DeleteProfileCommand}" />
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditProfileCommand}" />
                            </ListView.InputBindings>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{DynamicResource Col.ProfileName}" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run>
                                                        <Run.Style>
                                                            <Style TargetType="{x:Type Run}">
                                                                <Setter Property="Text" Value="" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUnreadable}" Value="True">
                                                                        <Setter Property="Text" Value="{DynamicResource Profiles.Unreadable}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Run.Style>
                                                    </Run>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{DynamicResource Col.Target}" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Target, Converter={StaticResource TargetText}}"
                                                           ToolTip="{Binding TargetTooltip}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{DynamicResource Col.Hotkey}" Width="90" DisplayMemberBinding="{Binding Hotkey}" />
                                    <GridViewColumn Header="{DynamicResource Col.MouseConstraint}" Width="86" DisplayMemberBinding="{Binding MouseConstraint, Converter={StaticResource YesNo}}" />
                                    <GridViewColumn Header="{DynamicResource Col.X}" Width="56" DisplayMemberBinding="{Binding X}" />
                                    <GridViewColumn Header="{DynamicResource Col.Y}" Width="56" DisplayMemberBinding="{Binding Y}" />
                                    <GridViewColumn Header="{DynamicResource Col.Width}" Width="56" DisplayMemberBinding="{Binding Width}" />
                                    <GridViewColumn Header="{DynamicResource Col.Height}" Width="56" DisplayMemberBinding="{Binding Height}" />
                                    <GridViewColumn Header="{DynamicResource Col.AutoApply}" Width="76" DisplayMemberBinding="{Binding AutoApply, Converter={StaticResource YesNo}}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Grid>

                <!-- 오버레이 버튼 (메뉴 지도 2.5, 4). 메뉴 막대와 트레이가 같은 Overlay 객체를 본다. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Page, Converter={StaticResource EqualsToVisibility}, ConverterParameter={x:Static vm:AppPage.Overlay}}">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{DynamicResource Nav.Overlay}" />
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{DynamicResource Overlay.Subtitle}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Overlay.Activation}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                            <RadioButton Style="{StaticResource ChoiceCardStyle}" GroupName="OverlayActivation"
                                         IsChecked="{Binding Overlay.IsClick}" AutomationProperties.Name="{DynamicResource Overlay.Click}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Overlay.Click}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Overlay.Click.Hint}" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ChoiceCardStyle}" GroupName="OverlayActivation"
                                         IsChecked="{Binding Overlay.IsDwell}" AutomationProperties.Name="{DynamicResource Overlay.Dwell}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Overlay.Dwell}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Overlay.Dwell.Hint}" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- 드웰을 골라야 열린다(계획 4.1 "켤 수 있으면 켜져 있다") -->
                        <DockPanel IsEnabled="{Binding Overlay.IsDwell}" Margin="0,0,0,20">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"
                                       Text="{DynamicResource Overlay.DwellTime}" Margin="0,0,14,0" />
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="52" TextAlignment="Right"
                                       Text="{Binding Overlay.DwellSeconds, StringFormat={}{0:0.0} s}" />
                            <Slider Minimum="0.2" Maximum="5.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    SmallChange="0.1" LargeChange="0.5" VerticalAlignment="Center"
                                    Value="{Binding Overlay.DwellSeconds}" AutomationProperties.Name="{DynamicResource Overlay.DwellTime}" />
                        </DockPanel>

                        <CheckBox IsChecked="{Binding Overlay.Hidden}" Content="{DynamicResource Overlay.Hidden}" />
                        <TextBlock Style="{StaticResource FieldHintStyle}" Margin="28,0,0,10" Text="{DynamicResource Overlay.Hidden.Hint}" />
                        <CheckBox IsChecked="{Binding Overlay.ToggleVisible}" Content="{DynamicResource Overlay.Switch}" />
                        <TextBlock Style="{StaticResource FieldHintStyle}" Margin="28,0,0,10" Text="{DynamicResource Overlay.Switch.Hint}" />
                        <CheckBox IsChecked="{Binding Overlay.Locked}" Content="{DynamicResource Overlay.Locked}" />
                        <TextBlock Style="{StaticResource FieldHintStyle}" Margin="28,0,0,18" Text="{DynamicResource Overlay.Locked.Hint}" />

                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Overlay.CloseAll}"
                                    Command="{Binding CloseAllOverlaysCommand}" AutomationProperties.Name="{DynamicResource Overlay.CloseAll}" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource Overlay.Profiles}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource FieldHintStyle}" Margin="0,0,0,8" Text="{DynamicResource Overlay.Profiles.Hint}" />
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 체크는 값을 보여 주기만 하고(OneWay), 바꾸는 것은 명령이다 - 저장이 끝나면 목록이 다시 그려진다. -->
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding OverlayEnabled, Mode=OneWay}"
                                              Command="{Binding DataContext.SetProfileOverlayCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                              CommandParameter="{Binding}">
                                        <CheckBox.Style>
                                            <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnreadable}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 단축키 (메뉴 지도 [단축키]). 등록 결과가 아래 목록에 그대로 보인다. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Page, Converter={StaticResource EqualsToVisibility}, ConverterParameter={x:Static vm:AppPage.Hotkeys}}">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,14,0" DataContext="{Binding Hotkeys}">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{DynamicResource Nav.Hotkeys}" />
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{DynamicResource Hotkeys.Subtitle}" />

                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource Hotkeys.ApplyAll}" />
                        <TextBlock Style="{StaticResource FieldHintStyle}" Margin="0,0,0,8" Text="{DynamicResource Hotkeys.ApplyAll.Hint}" />
                        <!-- 줄마다 저장하고 줄마다 바로 검사한다. 못 쓰는 조합이면 빨간 테두리와 이유가 붙는다. -->
                        <Border DataContext="{Binding ApplyAll}" BorderThickness="2" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="64" Content="{DynamicResource Hotkeys.Save}"
                                            Command="{Binding SaveCommand}" AutomationProperties.Name="{DynamicResource Hotkeys.ApplyAll.Save}" />
                                    <CheckBox VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="{Binding Enabled}"
                                              AutomationProperties.Name="{DynamicResource Hotkeys.ApplyAll.Enabled}" />
                                    <local:HotkeyPicker Text="{Binding Combination, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}"
                                                        DetectingChanged="OnPickerDetecting" HorizontalAlignment="Left"
                                                        AutomationProperties.Name="{DynamicResource Hotkeys.ApplyAll.Combination}" />
                                </DockPanel>
                                <TextBlock Margin="34,4,0,0" TextWrapping="Wrap" Text="{Binding Problem}" Foreground="{DynamicResource AppDangerBrush}"
                                           Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Margin="34,4,0,0" Style="{StaticResource FieldHintStyle}" Text="{DynamicResource Hotkeys.Dirty}"
                                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource FieldHintStyle}" Margin="10,0,0,0" Text="{DynamicResource Hotkeys.Capture.Hint}" />
                        <TextBlock Margin="10,2,0,20" TextWrapping="Wrap" Text="{Binding ApplyAllState}" Foreground="{DynamicResource AppMutedTextBrush}" />

                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource Hotkeys.Profile}" />
                        <TextBlock Style="{StaticResource FieldHintStyle}" Margin="0,0,0,8" Text="{DynamicResource Hotkeys.Profile.Hint}" />
                        <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Margin="0,0,0,20" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="{DynamicResource Hotkeys.Profile}" />
                        <StackPanel Margin="0,-8,0,20" Visibility="{Binding HasSelectedProfile, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox IsChecked="{Binding ProfileHotkeysEnabled}" Content="{DynamicResource Hotkeys.Profile.Enabled}" />
                            <TextBlock Style="{StaticResource FieldHintStyle}" Margin="28,0,0,10" Text="{DynamicResource Hotkeys.Profile.Enabled.Hint}" />
                            <ItemsControl ItemsSource="{Binding Sets}" Margin="0,0,0,0" IsEnabled="{Binding ProfileHotkeysEnabled}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="2" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="64" Content="{DynamicResource Hotkeys.Save}"
                                                            Command="{Binding SaveCommand}" AutomationProperties.Name="{DynamicResource Hotkeys.Profile.Save}" />
                                                    <ComboBox DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" IsEnabled="{Binding Enabled}" VerticalContentAlignment="Center"
                                                              ItemsSource="{Binding DataContext.ActionOptions, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                              DisplayMemberPath="Display" SelectedValuePath="Action" SelectedValue="{Binding Action}"
                                                              AutomationProperties.Name="{DynamicResource Hotkeys.Set.Action}" />
                                                    <CheckBox VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="{Binding Enabled}"
                                                              AutomationProperties.Name="{DynamicResource Hotkeys.Set.Enabled}" />
                                                    <local:HotkeyPicker Text="{Binding Combination, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}"
                                                                        DetectingChanged="OnPickerDetecting" HorizontalAlignment="Left"
                                                                        AutomationProperties.Name="{Binding Label}" />
                                                </DockPanel>
                                                <TextBlock Margin="34,4,0,0" TextWrapping="Wrap" Text="{Binding Problem}" Foreground="{DynamicResource AppDangerBrush}"
                                                           Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Margin="34,4,0,0" Style="{StaticResource FieldHintStyle}" Text="{DynamicResource Hotkeys.Dirty}"
                                                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource FieldHintStyle}" Margin="10,2,0,0" Text="{DynamicResource Hotkeys.Set.Hint}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource Hotkeys.Registered}" />
                        <TextBlock Style="{StaticResource FieldHintStyle}" Margin="0,0,0,8" Text="{DynamicResource Hotkeys.Registered.Hint}" />
                        <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="{DynamicResource Hotkeys.Registered}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Action}" Foreground="{DynamicResource AppMutedTextBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding State}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Foreground="{DynamicResource AppMutedTextBrush}" Text="{DynamicResource Hotkeys.Registered.Empty}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- 설정 (시안 C 에서 미리보기 열을 뺀 모양, notes/mocks/2026-09-30_settings-page). 바꾸면 바로 저장하고 적용한다. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Page, Converter={StaticResource EqualsToVisibility}, ConverterParameter={x:Static vm:AppPage.Settings}}">
                    <Grid MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,14,0" DataContext="{Binding Settings}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{DynamicResource Nav.Settings}" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{DynamicResource Settings.Subtitle}" />

                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Settings.Theme}" />
                            <TextBlock Style="{StaticResource FieldHintStyle}" Margin="0,0,0,6" Text="{DynamicResource Settings.Theme.Hint}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,18">
                                <RadioButton Style="{StaticResource ChoiceCardStyle}" GroupName="ThemeChoice"
                                             IsChecked="{Binding IsThemeSystem}" AutomationProperties.Name="{DynamicResource Settings.Theme.System}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.Theme.System}" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource Settings.Theme.System.Hint}" FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ChoiceCardStyle}" GroupName="ThemeChoice"
                                             IsChecked="{Binding IsThemeLight}" AutomationProperties.Name="{DynamicResource Settings.Theme.Light}">
                                    <TextBlock Text="{DynamicResource Settings.Theme.Light}" FontWeight="SemiBold" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource ChoiceCardStyle}" GroupName="ThemeChoice"
                                             IsChecked="{Binding IsThemeDark}" AutomationProperties.Name="{DynamicResource Settings.Theme.Dark}">
                                    <TextBlock Text="{DynamicResource Settings.Theme.Dark}" FontWeight="SemiBold" />
                                </RadioButton>
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Settings.Scale}" />
                            <TextBlock Style="{StaticResource FieldHintStyle}" Margin="0,0,0,6" Text="{DynamicResource Settings.Scale.Hint}" />
                            <DockPanel Margin="0,4,0,18">
                                <Button DockPanel.Dock="Right" Margin="12,0,0,0" Content="{DynamicResource Settings.Scale.Reset}"
                                        Command="{Binding ResetScaleCommand}" AutomationProperties.Name="{DynamicResource Settings.Scale.Reset}" />
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="52" TextAlignment="Right"
                                           FontWeight="SemiBold" Text="{Binding ScaleText}" />
                                <Slider x:Name="ScaleSlider" Minimum="75" Maximum="125" TickFrequency="5" IsSnapToTickEnabled="True"
                                        SmallChange="5" LargeChange="5" VerticalAlignment="Center"
                                        Value="{Binding ScalePercent}" AutomationProperties.Name="{DynamicResource Settings.Scale}"
                                        Thumb.DragStarted="OnScaleDragStarted" Thumb.DragCompleted="OnScaleDragCompleted" />
                            </DockPanel>

                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Settings.Language}" />
                            <TextBlock Style="{StaticResource FieldHintStyle}" Margin="0,0,0,6" Text="{DynamicResource Settings.Language.Hint}" />
                            <ComboBox Width="200" HorizontalAlignment="Left" Margin="0,4,0,18" VerticalContentAlignment="Center"
                                      ItemsSource="{x:Static vm:SettingsViewModel.LanguageOptions}" DisplayMemberPath="Display"
                                      SelectedValuePath="Code" SelectedValue="{Binding Language}"
                                      AutomationProperties.Name="{DynamicResource Settings.Language}" />

                            <CheckBox IsChecked="{Binding StartWithWindows}" Content="{DynamicResource Settings.Startup}" />
                            <TextBlock Style="{StaticResource FieldHintStyle}" Margin="28,0,0,10" Text="{DynamicResource Settings.Startup.Hint}" />
                            <CheckBox IsChecked="{Binding RememberWindow}" Content="{DynamicResource Settings.Remember}" />
                            <TextBlock Style="{StaticResource FieldHintStyle}" Margin="28,0,0,10" Text="{DynamicResource Settings.Remember.Hint}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 로그와 정보 (메뉴 지도 [로그와 정보]). 위는 정보, 아래는 로그 - 로그가 남는 높이를 다 쓴다. -->
                <Grid Margin="0,0,14,0" x:Name="LogAndAboutPage" IsVisibleChanged="OnLogPageVisibleChanged"
                      Visibility="{Binding Page, Converter={StaticResource EqualsToVisibility}, ConverterParameter={x:Static vm:AppPage.LogAndAbout}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" MaxWidth="900" HorizontalAlignment="Left" DataContext="{Binding About}">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="{DynamicResource Nav.LogAndAbout}" />
                        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{DynamicResource About.Subtitle}" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldHintStyle}" Margin="0,0,16,4" VerticalAlignment="Top" Text="{DynamicResource About.Version}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{Binding Info.Version, Mode=OneWay}" AutomationProperties.Name="{DynamicResource About.Version}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldHintStyle}" Margin="0,0,16,4" VerticalAlignment="Top" Text="{DynamicResource About.Runtime}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{Binding Info.Runtime, Mode=OneWay}" AutomationProperties.Name="{DynamicResource About.Runtime}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldHintStyle}" Margin="0,0,16,4" VerticalAlignment="Top" Text="{DynamicResource About.Administrator}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{Binding AdministratorText, Mode=OneWay}" AutomationProperties.Name="{DynamicResource About.Administrator}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldHintStyle}" Margin="0,0,16,4" VerticalAlignment="Top" Text="{DynamicResource About.Executable}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{Binding Info.ExecutablePath, Mode=OneWay}" AutomationProperties.Name="{DynamicResource About.Executable}" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldHintStyle}" Margin="0,0,16,4" VerticalAlignment="Top" Text="{DynamicResource About.ProfilesFolder}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{Binding Info.ProfilesFolder, Mode=OneWay}" AutomationProperties.Name="{DynamicResource About.ProfilesFolder}" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldHintStyle}" Margin="0,0,16,4" VerticalAlignment="Top" Text="{DynamicResource About.SettingsKey}" />
                            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{Binding SettingsKeyPath, Mode=OneWay}" AutomationProperties.Name="{DynamicResource About.SettingsKey}" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldHintStyle}" Margin="0,0,16,4" VerticalAlignment="Top" Text="{DynamicResource About.OverlayKey}" />
                            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{Binding OverlayKeyPath, Mode=OneWay}" AutomationProperties.Name="{DynamicResource About.OverlayKey}" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldHintStyle}" Margin="0,0,16,4" VerticalAlignment="Top" Text="{DynamicResource About.HotkeyKey}" />
                            <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{Binding HotkeyKeyPath, Mode=OneWay}" AutomationProperties.Name="{DynamicResource About.HotkeyKey}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                            <Button Content="{DynamicResource About.OpenProfiles}" Command="{Binding OpenProfilesFolderCommand}" Margin="0,0,8,0"
                                    AutomationProperties.Name="{DynamicResource About.OpenProfiles}" />
                            <Button Content="{DynamicResource About.CopyInfo}" Command="{Binding CopyInfoCommand}" Margin="0,0,8,0"
                                    AutomationProperties.Name="{DynamicResource About.CopyInfo}" />
                            <Button Content="{DynamicResource About.CopySettingsKey}" Command="{Binding CopySettingsKeyCommand}"
                                    AutomationProperties.Name="{DynamicResource About.CopySettingsKey}" />
                        </StackPanel>
                    </StackPanel>

                    <DockPanel Grid.Row="1" MinHeight="180" DataContext="{Binding Log}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}"
                                       Text="{Binding CountText}" />
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0,0,16,0" Text="{DynamicResource Log.Title}" />
                            <ComboBox DockPanel.Dock="Left" Width="150" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding LevelOptions}" DisplayMemberPath="Display" SelectedValuePath="Level" SelectedValue="{Binding MinLevel}"
                                      AutomationProperties.Name="{DynamicResource Log.Level}" />
                            <ComboBox DockPanel.Dock="Left" Width="110" Margin="0,0,12,0" VerticalContentAlignment="Center"
                                      ItemsSource="{x:Static vm:LogViewModel.MaxOptions}" SelectedItem="{Binding MaxEntries}"
                                      AutomationProperties.Name="{DynamicResource Log.Max}" />
                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding AutoScroll}" Content="{DynamicResource Log.AutoScroll}" />
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{DynamicResource Log.Clear}" Command="{Binding ClearCommand}" Margin="0,0,8,0" AutomationProperties.Name="{DynamicResource Log.Clear}" />
                            <Button Content="{DynamicResource Log.Copy}" Command="{Binding CopyCommand}" Margin="0,0,8,0" AutomationProperties.Name="{DynamicResource Log.Copy}" />
                            <Button Content="{DynamicResource Log.Export}" Command="{Binding ExportCommand}" AutomationProperties.Name="{DynamicResource Log.Export}" />
                        </StackPanel>
                        <Grid>
                            <ListBox x:Name="LogList" ItemsSource="{Binding Rows}" Background="{DynamicResource AppCanvasBrush}"
                                     BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Foreground="{DynamicResource AppTextBrush}"
                                     FontFamily="Consolas, Malgun Gothic" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="{DynamicResource Log.Title}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Padding" Value="8,2" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <Border Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}"
                                       Text="{DynamicResource Log.Empty}" IsHitTestVisible="False"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- 상태 줄 -->
        <Border Grid.Row="2" Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <!-- 위치 덮어쓰기 뒤에만 보인다(D-021 결정 3). 다음 변경이 저장되면 사라진다. -->
                <Button DockPanel.Dock="Right" Content="{DynamicResource Action.Undo}" MinHeight="32" Padding="12,2"
                        Command="{Binding UndoCommand}"
                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="{DynamicResource Action.UndoHint}"
                        AutomationProperties.Name="{DynamicResource Action.Undo}" />
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="13"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
