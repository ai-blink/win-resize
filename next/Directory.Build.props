<Project>
  <!-- WPF 앱 버전(한 곳). 표기는 PyQt5 배포판(0.01.5)과 같은 0.0x.y 체계를 잇는다.
       InformationalVersion 이 사람이 읽는 버전이고, 앱이 사이드바와 트레이에 보여 준다.
       Version/FileVersion 은 숫자만 받으므로 같은 값을 0.2.0 으로 적는다. -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <!-- 네 번째 자리는 프리뷰 번호(preview.3 -> .3). -->
    <FileVersion>0.2.0.5</FileVersion>
    <InformationalVersion>0.02.0-preview.5</InformationalVersion>
    <!-- .NET 은 기본으로 +커밋해시를 붙인다. 화면에 보이는 버전이 패치노트와 같아야 하므로 끈다. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>WindowResizer</Product>
  </PropertyGroup>
</Project>
